# Anthropic API key — used by the LLM prompt chain (lib/llm.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the email-writing model (resume → email drafting/rewrite).
# Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the recipient-finding model (company → founder/email web
# search). Defaults to claude-opus-4-8 for stronger research reasoning.
# ANTHROPIC_RECIPIENT_MODEL=claude-opus-4-8

# Hunter Email Finder — used by the company → founder email lookup (lib/hunter.ts).
# Free tier ~25-50 finds/month; a free test key works for development.
# Get one at https://hunter.io/api-keys. If unset, lookups still run but skip
# verification and fall back to a suggested firstname@domain address.
HUNTER_API_KEY=
