# Anthropic API key — used by the LLM prompt chain (lib/llm.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for the prompt chain
# ANTHROPIC_MODEL=claude-opus-4-8

# Hunter Email Finder — used by the company → founder email lookup (lib/hunter.ts).
# Free tier ~25-50 finds/month; a free test key works for development.
# Get one at https://hunter.io/api-keys. If unset, lookups still run but skip
# verification and fall back to a suggested firstname@domain address.
HUNTER_API_KEY=
